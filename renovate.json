{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":separatePatchReleases"
  ],
  "packageRules": [
    {
      "description": "Patch updates are merged automatically (specific rules below override this)",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["fhempy"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "2 days",
      "automerge": true
    },
    {
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["pin", "digest"],
      "automerge": true
    },
    {
      "description": "Major updates of the image content block the scheduled patch release (scripts/release-check.sh)",
      "matchManagers": ["dockerfile", "pip_requirements"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"]
    }
  ]
}
